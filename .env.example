# ==========================================
# Hermes Cloud 实例配置
# ==========================================

# 是否开启 Web 桌面免密直接登录（true: 点开链接直接进桌面无需输入账号密码；false: 需要密码）
DISABLE_AUTH=true

# 外部访问公网 IP 或域名（用于人机接管时自动生成 Web 桌面直达链接）
PUBLIC_HOST=43.130.29.47


# 实例 1（主实例）
PORT_INSTANCE_1=8444
VNC_PASSWORD_1=hermes

# 实例 2（预留从实例）
PORT_INSTANCE_2=8445
VNC_PASSWORD_2=hermes

# ==========================================
# Hermes Agent 模型配置 (OpenRouter)
# ==========================================
OPENROUTER_API_KEY=
HERMES_MODEL=z-ai/glm-5.3-flash

# ==========================================
# Web 搜索与网页抓取配置 (Firecrawl)
# ==========================================
FIRECRAWL_API_KEY=

# ==========================================
# Telegram 机器人网关配置 (7x24h 远程交互)
# ==========================================
# 由 @BotFather 提供的 Bot Token
TELEGRAM_BOT_TOKEN=
# 允许与 Bot 交互的 Telegram 用户数字 ID（白名单，多个用逗号隔开）
TELEGRAM_ALLOWED_USERS=
