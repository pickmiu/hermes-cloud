# ==========================================
# Hermes Cloud 实例配置
# ==========================================

# 实例 1（主实例）
PORT_INSTANCE_1=8444
VNC_PASSWORD_1=hermes

# 实例 2（预留从实例）
PORT_INSTANCE_2=8445
VNC_PASSWORD_2=hermes

# ==========================================
# Hermes Agent 模型配置 (OpenRouter)
# ==========================================
# 在此处填入您的 OpenRouter API Key
OPENROUTER_API_KEY=
# 默认使用模型（如未设置则默认为 z-ai/glm-5.3-flash）
HERMES_MODEL=z-ai/glm-5.3-flash
